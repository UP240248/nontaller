{
  "name": "tallerbus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "db:local": "node scripts/local-db.mjs",
    "generate": "node --env-file=.local/backend.env node_modules/prisma/build/index.js generate",
    "migrate": "node --env-file=.local/backend.env node_modules/prisma/build/index.js migrate deploy --schema backend/prisma/schema.prisma",
    "bootstrap": "node --env-file=.local/backend.env backend/dist/bootstrap.js",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint backend/src frontend/src scripts tests",
    "test:unit": "npm run build -w backend && node --test tests/unit.test.mjs tests/local-status.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "dev:api": "node --env-file=.local/backend.env backend/dist/main.js",
    "dev:web": "npm run start -w frontend",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e",
    "seed:dev": "node --env-file=.local/backend.env scripts/seed-dev.mjs",
    "setup": "node scripts/setup.mjs",
    "backup:local": "node --env-file=.local/backend.env scripts/backup-local.mjs",
    "backup:verify": "node --env-file=.local/backend.env scripts/verify-backup.mjs",
    "test:load": "node --env-file=.local/test.env scripts/benchmark-local.mjs",
    "status:local": "node --env-file=.local/backend.env scripts/status-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "vite": "7.3.7",
    "@modelcontextprotocol/sdk": "1.32.0"
  }
}
