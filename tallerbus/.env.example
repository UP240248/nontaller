# Configuración de referencia, sin credenciales. scripts/local-db.mjs genera .local/backend.env.
DATABASE_URL=mysql://USUARIO:CLAVE@127.0.0.1:3307/tallerbus
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
SESSION_HOURS=8
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=60
NODE_ENV=development
# Opcional: carpeta privada de evidencias. Default: .local/evidence (test: evidence-test).
# EVIDENCE_DIR=/ruta/privada/fuera/de/la/raiz/publica
